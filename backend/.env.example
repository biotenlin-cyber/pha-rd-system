DATABASE_URL=postgresql+asyncpg://pha:pha@localhost:5432/pha
SYNC_DATABASE_URL=postgresql+psycopg://pha:pha@localhost:5432/pha
CORS_ORIGINS=http://localhost:5173
SEARCH_BACKEND=trgm
LOG_LEVEL=INFO

# Anthropic Claude API (optional for AI patent drafting)
# Without this key, /patents/{id}/ai/draft endpoints return 503.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_OA_MODEL=claude-opus-4-7
ANTHROPIC_CRITIQUE_MODEL=claude-haiku-4-5-20251001
